# Environment variables example
# Copy to .env and fill in values

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Security
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cobalt
KEYCLOAK_CLIENT_ID=cobalt-pilot
KEYCLOAK_CLIENT_SECRET=cobalt-pilot-secret
OIDC_ISSUER_URL=http://localhost:8080/realms/cobalt
OIDC_AUDIENCE=cobalt-pilot

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# App
DEBUG=true
ENVIRONMENT=development
APP_NAME=cobalt-pilot-ryan-vo
APP_VERSION=1.0.0

# Reference repo
REFERENCE_REPO_URL=https://github.com/anthropics/knowledge-work-plugins
REFERENCE_REPO_BRANCH=main